# ---- troque TODOS os segredos antes de subir em produção ----
# producao (padrão): a API recusa subir com JWT_SECRET padrão/curto ou BOOTSTRAP_ADMIN_PASSWORD padrão.
# dev: aceita os padrões e publica /api/docs e /api/openapi.json (em produção ficam desligados).
APP_ENV=producao
POSTGRES_PASSWORD=edms-troque
JWT_SECRET=gere-com-openssl-rand-hex-32
S3_ACCESS_KEY=edms-minio
S3_SECRET_KEY=edms-minio-troque
BOOTSTRAP_ADMIN_EMAIL=admin@exemplo.com
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_PASSWORD=troque-no-primeiro-acesso

# OCR
OCR_ENGINE=tesseract          # tesseract | paddle (build com EXTRAS=ocr,paddle)
OCR_LANGUAGES=por+eng
OCR_DPI=300
OCR_ARCHIVE_PDFA=true
MAX_UPLOAD_MB=512

# Busca semântica (build com EXTRAS=ocr,llm,embeddings)
EMBEDDINGS_ENABLED=false

# Verificação de comentários atendidos via Claude (vazio = heurística local)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

WEB_PORT=8080

# Cifra segredos guardados pelo painel Configurações (ex.: chave da IA). Gere com: openssl rand -hex 32
CONFIG_SEGREDO=

# Integrações com GPlanSiS|Drawings, Writer e Sheets (vazio = desligada; mesmo valor no .env do outro sistema)
INTEGRACAO_DRAWINGS_SEGREDO=
INTEGRACAO_WRITER_SEGREDO=
INTEGRACAO_SHEETS_SEGREDO=
